{
 "doctype": "DocType",
 "name": "ERP AI Knowledge Document",
 "module": "ERP AI Assistant",
 "engine": "InnoDB",
 "is_submittable": 0,
 "issingle": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "tab_details",
   "fieldtype": "Tab Break",
   "label": "Details"
  },
  {
   "fieldname": "sec_main",
   "fieldtype": "Section Break",
   "label": "Document"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "in_preview": 1
  },
  {
   "fieldname": "col_main",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "source_type",
   "fieldtype": "Select",
   "label": "Source Type",
   "options": "documentation\nskill\nrdf\npolicy",
   "default": "documentation",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "source_key",
   "fieldtype": "Data",
   "label": "Source Key",
   "unique": 1,
   "description": "Stable id such as skill:NAME. Retrieval updates and deletes use this, not the title."
  },
  {
   "fieldname": "source_roles",
   "fieldtype": "Small Text",
   "label": "Source Roles",
   "description": "One role per line. Empty means any user who can use the assistant. Retrieval hides the document otherwise."
  },
  {
   "fieldname": "tab_content",
   "fieldtype": "Tab Break",
   "label": "Content"
  },
  {
   "fieldname": "sec_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "fieldname": "content",
   "fieldtype": "Long Text",
   "label": "Content"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1,
   "report": 1,
   "share": 1,
   "email": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "links": [],
 "autoname": "field:title",
 "naming_rule": "By fieldname",
 "title_field": "title",
 "show_title_field_in_link": 1,
 "search_fields": "source_type"
}
